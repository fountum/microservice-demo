<div class="container">
  <form action="/sales/report" method="POST">
    <div class="form-group">
      <label for="customers">Number of Customers</label>
      <input type="number" class="form-control" id="customers" placeholder="customers" name="customers">
    </div>
    <div class="form-group">
      <label for="cookies">Cookies Sold</label>
      <input type="number" class="form-control" id="cookies" placeholder="cookies" name="cookies"></textarea>
    </div>
    <div class="form-group">
      <label for="income">Income</label>
      <input type="number" class="form-control" id="income" placeholder="income" name="income"></textarea>
    </div>
    <button type="submit" class="btn btn-default">Submit</button>
  </form>
</div>
